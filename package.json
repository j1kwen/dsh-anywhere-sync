{
  "name": "dsh-anywhere-sync",
  "version": "1.2.2",
  "description": "Sync Harness profiles, plugin manifests, plugin settings and local plugin source across machines through a private Git repository.",
  "license": "MIT",
  "author": "j1kwen",
  "private": true,
  "type": "module",
  "main": "index.js",
  "homepage": "https://github.com/j1kwen/dsh-anywhere-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j1kwen/dsh-anywhere-sync.git"
  },
  "bugs": {
    "url": "https://github.com/j1kwen/dsh-anywhere-sync/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "config-sync",
    "profile",
    "plugin-manager"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "check": "node scripts/check-package.mjs",
    "test": "node scripts/engine-test.mjs && node scripts/http-test.mjs",
    "verify": "npm run check && npm test",
    "pack": "npm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
